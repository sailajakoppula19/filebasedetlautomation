{
	"name": "PL_File_ETL_Automation",
	"properties": {
		"activities": [
			{
				"name": "Get_Source_Files",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Source_Folder",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "ForEach_Files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get_Source_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get_Source_Files').output.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy_File_To_SQL",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_Source_CSV",
									"type": "DatasetReference",
									"parameters": {
										"PFoldername": "source",
										"pFilename": "@item().name"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_SQL_Sink",
									"type": "DatasetReference",
									"parameters": {
										"pTableName": {
											"value": "@concat('Stg_', replace(item().name,'.csv',''))",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "log_success",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Apply_Staging_To_Target",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[Log_ETL_Success]",
								"storedProcedureParameters": {
									"FileName": {
										"value": {
											"value": "@item().name",
											"type": "Expression"
										},
										"type": "String"
									},
									"RowsCopied": {
										"value": {
											"value": "@activity('Copy_File_To_SQL').output.rowsCopied",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"Status": {
										"value": "Success",
										"type": "String"
									},
									"TableName": {
										"value": {
											"value": "@replace(item().name,'.csv','')",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "sqldatabasels",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "Apply_Staging_To_Target",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "Copy_File_To_SQL",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[dbo].[Apply_Staging_To_Target]",
								"storedProcedureParameters": {
									"TableName": {
										"value": {
											"value": "@replace(item().name,'.csv','')",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "sqldatabasels",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "Archive_File",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "log_success",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings",
										"copyBehavior": "PreserveHierarchy"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_Source_CSV",
									"type": "DatasetReference",
									"parameters": {
										"PFoldername": "source",
										"pFilename": "@item().name"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_Source_CSV",
									"type": "DatasetReference",
									"parameters": {
										"PFoldername": "processed",
										"pFilename": "@item().name"
									}
								}
							]
						},
						{
							"name": "Delete_Source_File",
							"type": "Delete",
							"dependsOn": [
								{
									"activity": "Archive_File",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_Source_CSV",
									"type": "DatasetReference",
									"parameters": {
										"PFoldername": "source",
										"pFilename": "@item().name"
									}
								},
								"enableLogging": false,
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								}
							}
						}
					]
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-10-09T10:58:46Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}